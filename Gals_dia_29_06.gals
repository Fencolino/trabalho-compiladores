#Options
GenerateScanner = true
GenerateParser = true
Language = C++
ScannerName = Lexico
ParserName = Sintatico
SemanticName = Semantico
ScannerCaseSensitive = true
ScannerTable = Full
Input = String
Parser = SLR
#RegularDefinitions

#Tokens
// PALAVRAS RESERVADAS
KEY_CIN : "cin"
KEY_COUT : "cout"
KEY_IF : "if"
KEY_ELSE : "else"
KEY_SWITCH : "switch"
KEY_CASE : "case"
KEY_DEFAULT : "default"
KEY_FOR : "for"
KEY_WHILE : "while"
KEY_DO : "do"
KEY_BREAK : "break"
KEY_CONTINUE : "continue"
KEY_RETURN : "return"
KEY_INT : "int"
KEY_FLOAT : "float"
KEY_DOUBLE : "double"
KEY_CHAR : "char"
KEY_STRING : "string"
KEY_BOOL : "bool"
KEY_TRUE : "true"
KEY_FALSE : "false"
KEY_VOID : "void"


// OPERADORES ARITMÉTRICOS
KEY_SOMA : "+"
KEY_SUBTRACAO : "-"
KEY_MULTIPLICACAO : "*"
KEY_DIVISAO : "/"
KEY_MODULO : "%"
KEY_EXPONENCIACAO : "**"
KEY_DIVISAO_INTEIRA : "\/\/"
KEY_INCREMENTO : "++"
KEY_DECREMENTO : "--"
KEY_ATRIBUICAO : "="

// OPERADORES RELACIONAIS
KEY_MAIOR_QUE : ">"
KEY_MENOR_QUE : "<"
KEY_MAIOR_OU_IGUAL : ">="
KEY_MENOR_OU_IGUAL : "<="
KEY_IGUAL : "=="
KEY_DIFERENTE : "!="

// OPERADORES LÓGICOS
KEY_AND_LOGICO : "&&"
KEY_OR_LOGICO : "||"
KEY_NEGACAO : "!"

// OPERADORES BIT A BIT
KEY_DESLOCAMENTO_DIREITA : ">>"
KEY_DESLOCAMENTO_ESQUERDA : "<<"
KEY_E_BIT_A_BIT : "&" 
KEY_OU_BIT_A_BIT : "|" 
KEY_OU_EXCLUSIVO_BIT_A_BIT : "^" 
KEY_NAO_BIT_A_BIT : "~" 

// IDENTIFICADORES
KEY_ID : [a-zA-Z_][a-zA-Z0-9_]*

// LITERAIS
KEY_INT_VALOR : [0-9]+
KEY_BINARIO_VALOR : 0[bB][01]+
KEY_HEXADECIMAL_VALOR : 0[xX][0-9a-fA-F]+
KEY_REAL_VALOR : [0-9]+\.[0-9]+
KEY_CHAR_VALOR : '[^']'
KEY_STRING_VALOR : \"[^\"]*\"

// DELIMATADORES E PONTUADORES
KEY_ABRE_CHAVES : "{" 
KEY_FECHA_CHAVES : "}" 
KEY_ABRE_COLCHETES : "[" 
KEY_FECHA_COLCHETES : "]" 
KEY_ABRE_PARENTESES : "(" 
KEY_FECHA_PARENTESES : ")" 
KEY_PONTO_E_VIGULA : ";" 
KEY_VIGULA : "," 
KEY_PONTO : "." 
KEY_DOIS_PONTOS : ":" 


//COMENTARIO_SIMPLES : [/][/][" "-~]*
//COMENTARIO_MULTI : "/*" ( [^"*"] | "*"+ [^"*/"] )* "*"+ "/"

: [/][/][^\n\r]*
: "/*" ([^"*"] | ("*"+ [^"*/"]))* "*"+ "/"
: [\s\n\t\r]*
#NonTerminals
<programa>
<lista_comandos>
<comando>
<comando_declaracao>
<decl_ou_func>
<resto_decl_ou_func>
<declaracao_funcao>
<declaracao_variavel>
<resto_variavel>
<valor_inicializacao>
<continua_decl>
<tipo>
<comando_atribuicao>
<resto_cmd_id>
<atribuicao>
<chamada_funcao>
<operacao_incremento>
<acesso_matriz>
<acesso_matriz_resto>
<comando_entrada>
<itens_entrada>
<comando_saida>
<itens_saida>
<item_saida>
<resto_fator_saida>
<comando_controle>
<If>
<ElseOpcional>
<ProximoPassoIf>
<While>
<DoWhile>
<For>
<init_for>
<declaracao_for>
<resto_decl_para>
<atribuicao_for>
<cond_for>
<step_for>
<incremento_for>
<comando_funcao>
<lista_parametros>
<resto_param_vetor>
<resto_lista_parametros>
<argumentos>
<resto_argumentos>
<bloco>
<bloco_continuo>
<bloco_inicializacao>
<lista_inicializacao>
<item_inicializacao>
<resto_lista_init>
<exp>
<exp1>
<exp2>
<exp3>
<exp4>
<exp5>
<exp6>
<exp7>
<exp8>
<exp9>
<exp10>
<resto_fator_id>
<item_id>
<resto_item_id>
#Grammar
<programa> ::= <lista_comandos> ;

<lista_comandos> ::= <comando> <lista_comandos> | î ;

<comando> ::= <comando_declaracao>
            | <comando_atribuicao>
            | <comando_entrada>
            | <comando_saida>
            | <comando_controle>
            | <comando_funcao>;

<comando_declaracao> ::= <decl_ou_func> ;

<decl_ou_func> ::= <tipo> KEY_ID #2 <resto_decl_ou_func> ;

<resto_decl_ou_func> ::= <declaracao_funcao>
                       | <declaracao_variavel> ;

<declaracao_funcao> ::= #5 #7 #48 KEY_ABRE_PARENTESES <lista_parametros> KEY_FECHA_PARENTESES <bloco_continuo> #49 ;

<declaracao_variavel> ::= <resto_variavel> ;

<resto_variavel> ::= KEY_ABRE_COLCHETES KEY_INT_VALOR #8 KEY_FECHA_COLCHETES <resto_variavel>
                   | KEY_ATRIBUICAO <valor_inicializacao> #4 <continua_decl>
                   | <continua_decl> ;

<valor_inicializacao> ::= <exp> | <bloco_inicializacao> ;

<continua_decl> ::= KEY_VIGULA KEY_ID #2 <resto_variavel>
                  | KEY_PONTO_E_VIGULA ;

<tipo> ::= KEY_INT #1 | KEY_FLOAT #1 | KEY_DOUBLE #1 | KEY_CHAR #1 | KEY_STRING #1 | KEY_BOOL #1;

<comando_atribuicao> ::= KEY_ID #3 <resto_cmd_id> ;

<resto_cmd_id> ::= <atribuicao>
                 | <chamada_funcao>
                 | <operacao_incremento>
                 | <acesso_matriz> ;

<atribuicao> ::= KEY_ATRIBUICAO <valor_inicializacao> #4 KEY_PONTO_E_VIGULA ;

<chamada_funcao> ::= KEY_ABRE_PARENTESES #28 <argumentos> KEY_FECHA_PARENTESES #23 KEY_PONTO_E_VIGULA ;

<operacao_incremento> ::= KEY_INCREMENTO #46 KEY_PONTO_E_VIGULA
                        | KEY_DECREMENTO #47 KEY_PONTO_E_VIGULA ;

<acesso_matriz> ::= KEY_ABRE_COLCHETES <exp> #25 KEY_FECHA_COLCHETES <acesso_matriz_resto> ;

<acesso_matriz_resto> ::= <acesso_matriz>
                        | #32 <atribuicao>
                        | <operacao_incremento> ;

<comando_entrada> ::= KEY_CIN <itens_entrada> KEY_PONTO_E_VIGULA ;

<itens_entrada> ::= KEY_DESLOCAMENTO_DIREITA <item_id> <itens_entrada> | î ;

<comando_saida> ::= KEY_COUT <itens_saida> KEY_PONTO_E_VIGULA ;

<itens_saida> ::= KEY_DESLOCAMENTO_ESQUERDA <exp7> #27 <itens_saida> | î ;

<item_saida> ::= KEY_STRING_VALOR 
               | KEY_INT_VALOR 
               | KEY_REAL_VALOR 
               | KEY_CHAR_VALOR 
               | KEY_ID #3 #21 <resto_fator_saida> 
               | KEY_ABRE_PARENTESES <exp> KEY_FECHA_PARENTESES ;

<resto_fator_saida> ::= KEY_ABRE_COLCHETES <exp> KEY_FECHA_COLCHETES <resto_fator_saida>
                      | KEY_ABRE_PARENTESES <argumentos> KEY_FECHA_PARENTESES 
                      | î ;

<comando_controle> ::= <If>
                     | <While>
                     | <For>
                     | <DoWhile> ;

<If> ::= KEY_IF KEY_ABRE_PARENTESES <exp> KEY_FECHA_PARENTESES #34 <bloco> <ElseOpcional> #35 ;

<ElseOpcional> ::= KEY_ELSE #36 <ProximoPassoIf> | î ;

<ProximoPassoIf> ::= <If> | <bloco> ;

<While> ::= KEY_WHILE #37 KEY_ABRE_PARENTESES <exp> KEY_FECHA_PARENTESES #38 <bloco> #39 ;

<DoWhile> ::= KEY_DO #40 <bloco> KEY_WHILE KEY_ABRE_PARENTESES <exp> KEY_FECHA_PARENTESES #41 KEY_PONTO_E_VIGULA ;

<For> ::= KEY_FOR #5 KEY_ABRE_PARENTESES <init_for> KEY_PONTO_E_VIGULA #42 <cond_for> #43 KEY_PONTO_E_VIGULA <step_for> #44 KEY_FECHA_PARENTESES <bloco_continuo> #45 ;

<init_for> ::= <declaracao_for>
             | <atribuicao_for>
             | î ;

<declaracao_for> ::= <tipo> KEY_ID #2 <resto_decl_para> ;

<resto_decl_para> ::= KEY_ATRIBUICAO <exp> #4 | î ;

<atribuicao_for> ::= KEY_ID #3 KEY_ATRIBUICAO <exp> #4 ;

<cond_for> ::= <exp> | î ;

<step_for> ::= <incremento_for>
             | <atribuicao_for>
             | î ;

<incremento_for> ::= KEY_ID #3 KEY_INCREMENTO #46
                   | KEY_ID #3 KEY_DECREMENTO #47 ;

<comando_funcao> ::= KEY_VOID #1 KEY_ID #2 #5 #7 #48 KEY_ABRE_PARENTESES <lista_parametros> KEY_FECHA_PARENTESES <bloco_continuo> #49 | KEY_RETURN <exp> #22 KEY_PONTO_E_VIGULA;

<lista_parametros> ::= <tipo> #1 KEY_ID #2 #9 <resto_param_vetor> <resto_lista_parametros> | î ;

<resto_param_vetor> ::= KEY_ABRE_COLCHETES #8 KEY_FECHA_COLCHETES <resto_param_vetor> | î ;

<resto_lista_parametros> ::= KEY_VIGULA <tipo> #1 KEY_ID #2 #9 <resto_param_vetor> <resto_lista_parametros> | î ;

<argumentos> ::= <exp> #24 <resto_argumentos> | î ;

<resto_argumentos> ::= KEY_VIGULA <exp> #24 <resto_argumentos> | î ;

<bloco> ::= KEY_ABRE_CHAVES #5 <lista_comandos> KEY_FECHA_CHAVES #6 ;

<bloco_continuo> ::= KEY_ABRE_CHAVES <lista_comandos> KEY_FECHA_CHAVES #6 ;

<bloco_inicializacao> ::= KEY_ABRE_CHAVES #5 <lista_inicializacao> KEY_FECHA_CHAVES #6 ;

<lista_inicializacao> ::= <item_inicializacao> <resto_lista_init> ;

<item_inicializacao> ::= <exp> | <bloco_inicializacao> ;

<resto_lista_init> ::= KEY_VIGULA <lista_inicializacao> | î ;

// ======================================================================
//  MOTOR DE EXPRESSOES
// ======================================================================

<exp>   ::= <exp> KEY_OR_LOGICO <exp1> #11 | <exp1> ;
<exp1>  ::= <exp1> KEY_AND_LOGICO <exp2> #12 | <exp2> ;
<exp2>  ::= <exp2> KEY_OU_BIT_A_BIT <exp3> | <exp3> ;
<exp3>  ::= <exp3> KEY_OU_EXCLUSIVO_BIT_A_BIT <exp4> | <exp4> ;
<exp4>  ::= <exp4> KEY_E_BIT_A_BIT <exp5> | <exp5> ;

<exp5>  ::= <exp5> KEY_MAIOR_QUE      #33 <exp6> #13
          | <exp5> KEY_MENOR_QUE      #33 <exp6> #13
          | <exp5> KEY_MAIOR_OU_IGUAL #33 <exp6> #13
          | <exp5> KEY_MENOR_OU_IGUAL #33 <exp6> #13
          | <exp5> KEY_IGUAL          #33 <exp6> #13
          | <exp5> KEY_DIFERENTE      #33 <exp6> #13
          | <exp6> ;


<exp6>  ::= <exp6> KEY_DESLOCAMENTO_ESQUERDA <exp7> 
          | <exp6> KEY_DESLOCAMENTO_DIREITA <exp7> 
          | <exp7> ;

<exp7>  ::= <exp7> KEY_SOMA <exp8> #14
          | <exp7> KEY_SUBTRACAO <exp8> #15
          | <exp8> ;

<exp8>  ::= <exp8> KEY_MULTIPLICACAO <exp9> #16
          | <exp8> KEY_DIVISAO <exp9> #17
          | <exp8> KEY_MODULO <exp9> #18
          | <exp8> KEY_EXPONENCIACAO <exp9> #19
          | <exp8> KEY_DIVISAO_INTEIRA <exp9> 
          | <exp9> ;

<exp9>  ::= KEY_SUBTRACAO <exp10> 
          | KEY_NAO_BIT_A_BIT <exp10> 
          | KEY_NEGACAO <exp10> 
          | <exp10> ;

<exp10> ::= KEY_INT_VALOR #10
          | KEY_REAL_VALOR #10
          | KEY_CHAR_VALOR #10
          | KEY_STRING_VALOR #10
          | KEY_TRUE #10
          | KEY_FALSE #10
          | KEY_ID #10 <resto_fator_id> 
          | KEY_ABRE_PARENTESES <exp> KEY_FECHA_PARENTESES ;

<resto_fator_id> ::= KEY_ABRE_COLCHETES <exp> #25 KEY_FECHA_COLCHETES #31 <resto_fator_id> 
                   | KEY_ABRE_PARENTESES #28 <argumentos> KEY_FECHA_PARENTESES #23
                   | î ;

<item_id> ::= KEY_ID #20 <resto_item_id> ;

<resto_item_id> ::= KEY_ABRE_COLCHETES <exp> #25 KEY_FECHA_COLCHETES #30 | #29 ;





